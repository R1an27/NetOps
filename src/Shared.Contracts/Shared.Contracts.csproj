<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Assembly Metadata -->
    <PackageId>NetOps.Shared.Contracts</PackageId>
    <Version>1.0.0</Version>
    <Authors>NetOps Team</Authors>
    <Company>NetOps</Company>
    <Description>Core protocol contracts, binary message framing, payload DTOs, and safe stream utilities for NetOps system.</Description>
    <PackageTags>netops;protocol;framing;contracts;tcp</PackageTags>
  </PropertyGroup>

</Project>
