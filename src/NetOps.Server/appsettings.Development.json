{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // [3.2] Cho Server biết phải tin Keycloak nào
  // Cấu trúc này dựa trên template cấu hình chính thức của Keycloak.AuthServices.
  // https://nikiforovall.blog/keycloak-authorization-services-dotnet/configuration/configuration-authentication.html
  "Keycloak": {
    // Dùng realm netops đã tạo.
    "realm": "netops",
    // Địa chỉ Keycloak đang chạy trên máy.
    "auth-server-url": "http://localhost:8080/",
    // Cho phép dùng Keycloak qua HTTP trong môi trường phát triển hiện tại.
    "ssl-required": "none",
    // Client đại diện cho API Server: netops-backend.
    "resource": "netops-backend",
    // Kiểm tra token có dành cho backend này hay không.
    "verify-token-audience": true
  }
}
