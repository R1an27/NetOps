<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[Shared.Contracts]*,[Agent.Worker]*,[Master.Api]*,[Client.WinForms]Client.WinForms.Services.*</Include>
          <Exclude>[NetOps.Tests]*,[Client.WinForms]Client.WinForms.Forms.*</Exclude>
          <ExcludeByFile>**/Forms/**,**/*.Designer.cs</ExcludeByFile>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
          <SingleHit>false</SingleHit>
          <IncludeTestAssembly>false</IncludeTestAssembly>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
